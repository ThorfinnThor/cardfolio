{
  "name": "cardfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:sync": "node scripts/sync-public-data.mjs",
    "data:sync:sets": "node scripts/sync-public-data.mjs --sets-only",
    "catalog:audit": "node scripts/catalog-audit.mjs",
    "catalog:audit:summary": "node scripts/catalog-audit.mjs --summary",
    "cardtrader:discover": "node scripts/cardtrader-discovery.mjs",
    "cardtrader:audit": "node scripts/cardtrader-mapping-audit.mjs",
    "cardtrader:blueprint-id-audit": "node scripts/cardtrader-blueprint-id-audit.mjs",
    "cardtrader:review-report": "node scripts/cardtrader-review-report.mjs",
    "cardtrader:summary": "node scripts/cardtrader-workflow-summary.mjs",
    "semantic:index:build": "node scripts/semantic-index.mjs build",
    "semantic:index:check": "node scripts/semantic-index.mjs check",
    "semantic:index:bootstrap": "node scripts/semantic-index.mjs bootstrap-source",
    "semantic:reviews:import": "node scripts/import-artwork-reviews.mjs",
    "semantic:coverage:summary": "node scripts/semantic-index.mjs coverage-summary",
    "semantic:evaluate": "vitest run src/test/domain/semantic-card-search.benchmark.test.ts --reporter=verbose",
    "release:evidence": "node scripts/release-evidence.mjs",
    "release:check": "node scripts/check-release-gates.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
